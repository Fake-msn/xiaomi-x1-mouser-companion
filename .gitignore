config.json
*.log

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store
